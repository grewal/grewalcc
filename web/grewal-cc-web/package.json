{
  "name": "grewal-cc-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r dotenv/config node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:protos": "mkdir -p ./src/lib/grpc && grpc_tools_node_protoc --proto_path=../../protos --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=grpc_js:./src/lib/grpc --js_out=import_style=commonjs,binary:./src/lib/grpc --grpc_out=grpc_js:./src/lib/grpc ../../protos/home_general.proto",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.8",
    "autoprefixer": "^10.4.19",
    "cookie": "^1.0.2",
    "next": "^14.2.30",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "undici": "^7.11.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.6.1",
    "@storybook/addon-essentials": "^8.2.4",
    "@storybook/addon-interactions": "^8.2.4",
    "@storybook/addon-links": "^8.2.4",
    "@storybook/addon-onboarding": "^8.2.4",
    "@storybook/blocks": "^8.2.4",
    "@storybook/nextjs": "^8.2.4",
    "@storybook/react": "^8.2.4",
    "@storybook/test": "^8.2.4",
    "@types/cookie": "^1.0.0",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^17.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.4",
    "eslint-plugin-storybook": "^0.8.0",
    "google-protobuf": "^3.21.2",
    "grpc-tools": "^1.12.4",
    "storybook": "^8.2.4",
    "ts-protoc-gen": "^0.15.0",
    "typescript": "^5.5.2"
  }
}
