# Node.js dependencies
node_modules/

# Other things to ignore (build output, logs, etc.)
dist/
grewal.log
nohup.out
*.o
backups/

# Ignore generated Protobuf/gRPC files
*.pb.h
*.pb.cc
*.grpc.pb.h
*.grpc.pb.cc

# Bazel output files
/bazel-*
/MODULE.bazel
/MODULE.bazel.lock

# Terraform specific ignores
# --------------------------
# Ignore state files (contain sensitive info)
*.tfstate
*.tfstate.backup

# Ignore local Terraform directories
.terraform/

# Ignore crash log files
crash.log
crash.*.log

# Terraform local state files (use remote backend)
terraform.tfstate
terraform.tfstate.backup
*.tfstate # General pattern just in case
*.tfstate.* # Catches backups too

# Build output directories
[Bb]uild/
build*/

# CMake files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lib
*.a

# Executables
*.exe
*.out
*.app

# Ignore unnecessary bpf2go artifacts
*_bpfeb.go
*_bpfeb.o
*_b2g.o

# eBPF build artifacts
services/security-service/ebpf/kernel/*.o
services/security-service/ebpf/*.ll
services/security-service/ebpf/*.bc
services/security-service/ebpf/runtime

# =========================
# Frontend Build Artifacts
# =========================

# General Node.js
/web/node_modules
/web/.pnp
/web/.pnp.js
/web/.yarn/*
!/web/.yarn/patches
!/web/.yarn/plugins
!/web/.yarn/releases
!/web/.yarn/versions

# ================================
# Frontend: /web/grewal-cc-web
# ================================
/web/grewal-cc-web/.next/
/web/grewal-cc-web/out/
/web/grewal-cc-web/.DS_Store
/web/grewal-cc-web/*.pem
/web/grewal-cc-web/.env*.local

# Testing
/web/coverage

# Next.js (React)
/web/.next/
/web/out/

# Production
/web/build

# Misc
/web/.DS_Store
/web/*.pem

# Debug Logs
/web/npm-debug.log*
/web/yarn-debug.log*
/web/yarn-error.log*
/web/.pnpm-debug.log*

# Vercel
/web/.vercel

# TypeScript
/web/*.tsbuildinfo
/web/next-env.d.ts

# Local Environment Files (Crucial for security)
/web/.env*
!/web/.env.example

# Binary
services/grewalcc/grewalcc

# --- EXCEPTIONS ---
# required runtime artifact for the Go authz-service.
!/services/security-service/ebpf/kernel/xdp_ip_blocker.o

