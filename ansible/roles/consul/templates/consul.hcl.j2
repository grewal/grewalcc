# templates/consul.hcl.j2
# Deployed by Ansible

data_dir = "/consul/data"

# Non-dev server mode
server = true
bootstrap_expect = 1

enable_local_script_checks = true

# Container networking configuration.
# The 'raw' block tells Ansible's Jinja2 to ignore the HCL syntax.
bind_addr = "{% raw %}{{ GetInterfaceIP \"eth0\" }}{% endraw %}"
advertise_addr = "{% raw %}{{ GetInterfaceIP \"eth0\" }}{% endraw %}"
client_addr = "0.0.0.0"

# Enable UI
ui_config {
  enabled = true
}

# Enable DNS Interface on standard port 8600 (UDP/TCP)
ports {
  dns = 8600
}

# Note: HTTP API defaults to 8500

log_level = "INFO"
# enable_syslog = true

# Enable Prometheus Metrics Endpoint
#telemetry {
