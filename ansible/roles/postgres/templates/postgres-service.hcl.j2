service {
  name = "{{ postgres_consul_service_name }}"
  id   = "{{ postgres_consul_service_id }}"
  tags = {{ postgres_consul_tags | to_json }}
  
  # The port PUBLISHED to the host.
  port = {{ postgres_host_published_port }}
  
  # The address on the HOST where the service can be reached.
  address = "127.0.0.1"

  check {
    name     = "postgres-tcp-health-check"
    tcp      = "127.0.0.1:{{ postgres_host_published_port }}"
    interval = "{{ postgres_consul_health_check_interval }}"
    timeout  = "{{ postgres_consul_health_check_timeout }}"
    deregister_critical_service_after = "5m"
  }
}
