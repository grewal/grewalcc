#!/bin/bash
# roles/postgres/templates/backup_postgres_gcs.sh.j2

set -o errexit
set -o nounset
set -o pipefail

# Variables from Ansible
PG_CONTAINER_NAME="{{ postgres_container_name }}"
PG_USER="{{ postgres_user }}"
PG_DB_NAME="{{ postgres_db_name }}"
PG_PASSWORD="{{ postgres_password_vault }}"

BACKUP_DIR_HOST="{{ postgres_backup_dir_host }}"
GCS_BUCKET_PATH="{{ postgres_backup_gcs_bucket_path }}"
TIMESTAMP=$(date +"%Y%m%d%H%M%S")
BACKUP_FILENAME="pg_backup_${PG_DB_NAME}_${TIMESTAMP}.sql.gz"
LOCAL_BACKUP_PATH="${BACKUP_DIR_HOST}/${BACKUP_FILENAME}"

mkdir -p "${BACKUP_DIR_HOST}"

echo "Starting PostgreSQL backup for database '${PG_DB_NAME}'..."

# Perform the backup using docker exec
# We need to pass the password to pg_dump. PGPASSWORD env var is one way.
docker exec -e PGPASSWORD="${PG_PASSWORD}" "${PG_CONTAINER_NAME}" \
  pg_dump -U "${PG_USER}" -d "${PG_DB_NAME}" -h localhost -p {{ postgres_port_container }} --format=custom --blobs --verbose | gzip > "${LOCAL_BACKUP_PATH}"
  # Using localhost inside the container context. Port is the container's internal port.
  # --format=custom is generally recommended for pg_dump for flexibility with pg_restore.

if [ $? -eq 0 ]; then
  echo "PostgreSQL backup successful: ${LOCAL_BACKUP_PATH}"
else
  echo "PostgreSQL backup FAILED. Exit code: $?"
  exit 1
fi

echo "Uploading backup to GCS: ${GCS_BUCKET_PATH}/${BACKUP_FILENAME}"
# Ensure gcloud is configured and authenticated on the VM for this to work.
# The VM's service account needs 'Storage Object Creator' role on the bucket.
gcloud storage cp "${LOCAL_BACKUP_PATH}" "${GCS_BUCKET_PATH}/${BACKUP_FILENAME}"

if [ $? -eq 0 ]; then
  echo "GCS upload successful."
else
  echo "GCS upload FAILED. Exit code: $?"
  exit 1
fi

echo "Backup process complete."
exit 0
